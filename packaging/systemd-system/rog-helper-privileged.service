[Unit]
Description=ROG Helper privileged control service
Documentation=https://github.com/UdayaSri0/g-helper-linux/blob/Dev/docs/PERMISSIONS.md

[Service]
Type=dbus
BusName=io.github.roghelper.Privileged
ExecStart=@PRIVILEGED_EXEC@
User=root
Group=root
Restart=on-failure
RestartSec=1s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=no
ReadWritePaths=/sys/devices/system/cpu /sys/class/hwmon -/sys/class/leds -/sys/class/power_supply -/sys/devices/platform/asus-nb-wmi
RuntimeDirectory=rog-helper
RuntimeDirectoryMode=0700
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

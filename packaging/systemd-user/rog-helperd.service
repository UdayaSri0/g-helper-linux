[Unit]
Description=rog-helper daemon (user)
After=default.target

[Service]
Type=dbus
BusName=io.github.roghelper.Daemon
ExecStart=rog-helperd
Restart=on-failure
RestartSec=1
Environment=RUST_LOG=info
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target

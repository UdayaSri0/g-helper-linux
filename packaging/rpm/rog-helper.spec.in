%global debug_package %{nil}

Name:           @PACKAGE_NAME@
Version:        @VERSION@
Release:        @RPM_RELEASE@
Summary:        @SUMMARY@
License:        @LICENSE@
URL:            @HOMEPAGE@
Source0:        %{name}-%{version}-rpm-root.tar.xz
ExclusiveArch:  x86_64

BuildRequires:  systemd-rpm-macros
Requires:       hicolor-icon-theme

%description
@DESCRIPTION@

%prep
mkdir -p %{name}-%{version}
cd %{name}-%{version}
tar -xJf %{SOURCE0}

%build
# Release binaries are staged by the repository packaging pipeline.

%install
rm -rf %{buildroot}
cd %{name}-%{version}
mkdir -p %{buildroot}
cp -a usr %{buildroot}/

%post
/bin/systemctl daemon-reload >/dev/null 2>&1 || :

%preun
if [ "$1" -eq 0 ]; then
  /bin/systemctl stop rog-helper-privileged.service >/dev/null 2>&1 || :
fi

%postun
/bin/systemctl daemon-reload >/dev/null 2>&1 || :

%files
%license %{_docdir}/%{name}/LICENSE-APACHE
%license %{_docdir}/%{name}/LICENSE-MIT
%{_bindir}/rog-helper
%{_bindir}/rog-helper-ui
%{_bindir}/rog-helperd
%{_libexecdir}/rog-helper-privileged
%{_datadir}/applications/rog-helper.desktop
%{_datadir}/dbus-1/services/io.github.roghelper.Daemon.service
%{_datadir}/dbus-1/system-services/io.github.roghelper.Privileged.service
%{_datadir}/dbus-1/system.d/io.github.roghelper.Privileged.conf
%{_datadir}/polkit-1/actions/io.github.roghelper.policy
%{_datadir}/icons/hicolor/16x16/apps/rog-helper.png
%{_datadir}/icons/hicolor/24x24/apps/rog-helper.png
%{_datadir}/icons/hicolor/32x32/apps/rog-helper.png
%{_datadir}/icons/hicolor/48x48/apps/rog-helper.png
%{_datadir}/icons/hicolor/64x64/apps/rog-helper.png
%{_datadir}/icons/hicolor/128x128/apps/rog-helper.png
%{_datadir}/icons/hicolor/256x256/apps/rog-helper.png
%{_datadir}/icons/hicolor/512x512/apps/rog-helper.png
%{_datadir}/icons/hicolor/scalable/actions/rog-fan-symbolic.svg
%{_datadir}/metainfo/io.github.roghelper.UI.metainfo.xml
%{_datadir}/pixmaps/rog-helper.png
/usr/lib/systemd/user/rog-helperd.service
%{_unitdir}/rog-helper-privileged.service

%changelog
* @CHANGELOG_DATE@ @MAINTAINER@ - @VERSION@-@RPM_RELEASE@
- Build Fedora-family release package for rog-helper

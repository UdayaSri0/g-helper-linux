[Desktop Entry]
Type=Application
Name=rog-helper
Comment=Control ASUS ROG power, GPU, battery, and diagnostics on Linux
TryExec=rog-helper-ui
Exec=rog-helper-ui
Icon=rog-helper
Terminal=false
StartupNotify=true
StartupWMClass=io.github.roghelper.UI
Categories=Settings;HardwareSettings;
Keywords=ASUS;ROG;Laptop;Power;Battery;CPU;GPU;Diagnostics;
